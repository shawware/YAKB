{
    "name": "shawware/yakb",
    "description": "Yet Another KarmaBot — a Slack karma bot",
    "type": "project",
    "license": "GPL-3.0-only",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Shawware\\Yakb\\": "src/",
            "Shawware\\Yakb\\Storage\\": "storage/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shawware\\Yakb\\Tests\\": "tests/"
        }
    }
}
